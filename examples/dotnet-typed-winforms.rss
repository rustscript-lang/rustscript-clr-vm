// This Notepad application is written in RustScript. EventLoop only queues
// WinForms events from the dedicated UI thread; behavior stays here.
use System::IO::File;
use System::Windows::Forms::Form;
use System::Windows::Forms::RichTextBox;
use System::Windows::Forms::MenuStrip;
use System::Windows::Forms::ToolStripMenuItem;
use System::Windows::Forms::ToolStripSeparator;
use System::Windows::Forms::StatusStrip;
use System::Windows::Forms::ToolStripStatusLabel;
use System::Windows::Forms::Control::ControlCollection;
use System::Windows::Forms::ToolStripItemCollection;
use System::Windows::Forms::OpenFileDialog;
use System::Windows::Forms::SaveFileDialog;
use System::Windows::Forms::FontDialog;
use System::Windows::Forms::ColorDialog;
use System::Windows::EventLoop as Ui;

let form = Form::NewForm();
Form::SetFormText(form, "Untitled - RustScript Notepad");
Form::SetFormWidth(form, 960);
Form::SetFormHeight(form, 640);
Form::SetFormStartPosition(form, "CenterScreen");

let editor = RichTextBox::NewRichTextBox();
RichTextBox::SetRichTextBoxDock(editor, "Fill");
RichTextBox::SetRichTextBoxBorderStyle(editor, "None");
RichTextBox::SetRichTextBoxWordWrap(editor, true);

let menu = MenuStrip::NewMenuStrip();
MenuStrip::SetMenuStripDock(menu, "Top");
Form::SetFormMainMenuStrip(form, menu);
let menu_items = MenuStrip::GetMenuStripItems(menu);

let file_menu = ToolStripMenuItem::NewToolStripMenuItemString("&File");
let format_menu = ToolStripMenuItem::NewToolStripMenuItemString("F&ormat");
let view_menu = ToolStripMenuItem::NewToolStripMenuItemString("&View");
ToolStripItemCollection::AddToolStripItemInstance(menu_items, file_menu);
ToolStripItemCollection::AddToolStripItemInstance(menu_items, format_menu);
ToolStripItemCollection::AddToolStripItemInstance(menu_items, view_menu);

let new_item = ToolStripMenuItem::NewToolStripMenuItemString("&New");
let open_item = ToolStripMenuItem::NewToolStripMenuItemString("&Open...");
let save_item = ToolStripMenuItem::NewToolStripMenuItemString("&Save");
let save_as_item = ToolStripMenuItem::NewToolStripMenuItemString("Save &As...");
let exit_item = ToolStripMenuItem::NewToolStripMenuItemString("E&xit");
ToolStripMenuItem::SetToolStripMenuItemShortcutKeys(new_item, "Control, N");
ToolStripMenuItem::SetToolStripMenuItemShortcutKeys(open_item, "Control, O");
ToolStripMenuItem::SetToolStripMenuItemShortcutKeys(save_item, "Control, S");
ToolStripMenuItem::SetToolStripMenuItemShortcutKeys(save_as_item, "Control, Shift, S");
let file_items = ToolStripMenuItem::GetToolStripMenuItemDropDownItems(file_menu);
ToolStripItemCollection::AddToolStripItemInstance(file_items, new_item);
ToolStripItemCollection::AddToolStripItemInstance(file_items, open_item);
ToolStripItemCollection::AddToolStripItemInstance(file_items, save_item);
ToolStripItemCollection::AddToolStripItemInstance(file_items, save_as_item);
ToolStripItemCollection::AddToolStripItemInstance(file_items, ToolStripSeparator::NewToolStripSeparator());
ToolStripItemCollection::AddToolStripItemInstance(file_items, exit_item);

let font_item = ToolStripMenuItem::NewToolStripMenuItemString("&Font...");
let color_item = ToolStripMenuItem::NewToolStripMenuItemString("Text &Color...");
let format_items = ToolStripMenuItem::GetToolStripMenuItemDropDownItems(format_menu);
ToolStripItemCollection::AddToolStripItemInstance(format_items, font_item);
ToolStripItemCollection::AddToolStripItemInstance(format_items, color_item);

let wrap_item = ToolStripMenuItem::NewToolStripMenuItemString("&Word Wrap");
ToolStripMenuItem::SetToolStripMenuItemChecked(wrap_item, true);
let view_items = ToolStripMenuItem::GetToolStripMenuItemDropDownItems(view_menu);
ToolStripItemCollection::AddToolStripItemInstance(view_items, wrap_item);

let status = StatusStrip::NewStatusStrip();
StatusStrip::SetStatusStripDock(status, "Bottom");
let status_label = ToolStripStatusLabel::NewToolStripStatusLabel();
ToolStripStatusLabel::SetToolStripStatusLabelText(status_label, "Ready");
let status_items = StatusStrip::GetStatusStripItems(status);
ToolStripItemCollection::AddToolStripItemInstance(status_items, status_label);

let controls = Form::GetFormControls(form);
ControlCollection::Add(controls, editor);
ControlCollection::Add(controls, status);
ControlCollection::Add(controls, menu);

let open_dialog = OpenFileDialog::NewOpenFileDialog();
OpenFileDialog::SetOpenFileDialogFilter(open_dialog, "Text documents (*.txt)|*.txt|All files (*.*)|*.*");
OpenFileDialog::SetOpenFileDialogTitle(open_dialog, "Open");
let save_dialog = SaveFileDialog::NewSaveFileDialog();
SaveFileDialog::SetSaveFileDialogFilter(save_dialog, "Text documents (*.txt)|*.txt|All files (*.*)|*.*");
SaveFileDialog::SetSaveFileDialogTitle(save_dialog, "Save As");
SaveFileDialog::SetSaveFileDialogDefaultExt(save_dialog, "txt");
SaveFileDialog::SetSaveFileDialogAddExtension(save_dialog, true);
let font_dialog = FontDialog::NewFontDialog();
let color_dialog = ColorDialog::NewColorDialog();

Ui::BindClick(form, new_item, "new");
Ui::BindDialog(form, open_item, open_dialog, "open");
Ui::BindDialog(form, save_item, save_dialog, "save");
Ui::BindDialog(form, save_as_item, save_dialog, "save_as");
Ui::BindDialog(form, font_item, font_dialog, "font");
Ui::BindDialog(form, color_item, color_dialog, "color");
Ui::BindClick(form, wrap_item, "wrap");
Ui::BindClick(form, exit_item, "close");
Ui::BindClosing(form, "close");
Ui::Show(form);

let mut current_path = "";
let mut word_wrap = true;
while true {
    let action = Ui::Wait(form);
    if action == "new" {
        RichTextBox::SetRichTextBoxText(editor, "");
        current_path = "";
        Form::SetFormText(form, "Untitled - RustScript Notepad");
        ToolStripStatusLabel::SetToolStripStatusLabelText(status_label, "New document");
    }
    if action == "open" {
        if Ui::ShowDialog(form, open_dialog) == "OK" {
            current_path = OpenFileDialog::GetOpenFileDialogFileName(open_dialog);
            RichTextBox::SetRichTextBoxText(editor, File::ReadAllText(current_path));
            Form::SetFormText(form, current_path + " - RustScript Notepad");
            ToolStripStatusLabel::SetToolStripStatusLabelText(status_label, "Opened " + current_path);
        }
    }
    if action == "save" {
        if current_path == "" {
            if Ui::ShowDialog(form, save_dialog) == "OK" {
                current_path = SaveFileDialog::GetSaveFileDialogFileName(save_dialog);
            }
        }
        if current_path != "" {
            File::WriteAllText(current_path, RichTextBox::GetRichTextBoxText(editor));
            Form::SetFormText(form, current_path + " - RustScript Notepad");
            ToolStripStatusLabel::SetToolStripStatusLabelText(status_label, "Saved " + current_path);
        }
    }
    if action == "save_as" {
        SaveFileDialog::SetSaveFileDialogFileName(save_dialog, current_path);
        if Ui::ShowDialog(form, save_dialog) == "OK" {
            current_path = SaveFileDialog::GetSaveFileDialogFileName(save_dialog);
            File::WriteAllText(current_path, RichTextBox::GetRichTextBoxText(editor));
            Form::SetFormText(form, current_path + " - RustScript Notepad");
            ToolStripStatusLabel::SetToolStripStatusLabelText(status_label, "Saved " + current_path);
        }
    }
    if action == "font" {
        if Ui::ShowDialog(form, font_dialog) == "OK" {
            RichTextBox::SetRichTextBoxFont(editor, FontDialog::GetFontDialogFont(font_dialog));
        }
    }
    if action == "color" {
        if Ui::ShowDialog(form, color_dialog) == "OK" {
            RichTextBox::SetRichTextBoxForeColor(editor, ColorDialog::GetColorDialogColor(color_dialog));
        }
    }
    if action == "wrap" {
        word_wrap = !word_wrap;
        RichTextBox::SetRichTextBoxWordWrap(editor, word_wrap);
        ToolStripMenuItem::SetToolStripMenuItemChecked(wrap_item, word_wrap);
        ToolStripStatusLabel::SetToolStripStatusLabelText(status_label, "Word wrap changed");
    }
    if action == "close" || action == "__closed" {
        Ui::Close(form);
        break;
    }
}
