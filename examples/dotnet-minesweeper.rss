let mut flash_until = 0;
let mut flash_cells = new_board_array(cell_count);

Ui::Show(form);

while true {
    let mut action = Ui::WaitTimeout(form, 100);
    let mut board_changed = false;

    if flash_until > 0 && MonotonicClock::GetMilliseconds() >= flash_until {
        flash_until = 0;
        flash_cells = new_board_array(cell_count);
        board_changed = true;
    }

    let mut pointer_kind = "";
    let mut pointer_button = "";
    let mut pointer_x = -1;
    let mut pointer_y = -1;
    if action == "board_down" { pointer_kind = "down"; }
    if action == "board_up" { pointer_kind = "up"; }
    if action == "board_double" { pointer_kind = "double"; }
    if action == "board_leave" { pointer_kind = "leave"; }
    if pointer_kind != "" && pointer_kind != "leave" {
        pointer_button = Ui::GetPointerButton(form);
        pointer_x = Ui::GetPointerX(form);
        pointer_y = Ui::GetPointerY(form);
    }

    if active && started && !paused {
        let measured_elapsed = (MonotonicClock::GetMilliseconds() - started_at - paused_total) / 1000;
        if measured_elapsed != elapsed {
            elapsed = measured_elapsed;
            Visuals::SetSpriteText(time_counter, format_counter(elapsed));
        }
    }

    let mut difficulty_changed = false;
    if action == "beginner" {
        rows = 8;
        columns = 8;
        mine_total = 10;
        difficulty = 0;
        difficulty_changed = true;
    }
    if action == "intermediate" {
        rows = 16;
        columns = 16;
        mine_total = 40;
        difficulty = 1;
        difficulty_changed = true;
    }
    if action == "expert" {
        rows = 16;
        columns = 30;
        mine_total = 99;
        difficulty = 2;
        difficulty_changed = true;
    }
    if action == "custom" {
        let custom_values = show_custom_fields(form, rows, columns, mine_total);
        if custom_values[0].copy() == "ok" {
            let requested_rows = parse_positive_int(custom_values[1].copy());
            let requested_columns = parse_positive_int(custom_values[2].copy());
            let requested_mines = parse_positive_int(custom_values[3].copy());
            if requested_rows < 8 || requested_rows > 24 || requested_columns < 8 || requested_columns > 30 {
                Visuals::ShowMessage(form, "Height must be from 8 to 24, and width must be from 8 to 30.", "Custom Field");
            } else {
                if requested_mines < 1 || requested_mines >= requested_rows * requested_columns {
                    Visuals::ShowMessage(form, "Mines must be at least 1 and less than the number of squares.", "Custom Field");
                } else {
                    rows = requested_rows;
                    columns = requested_columns;
                    mine_total = requested_mines;
                    difficulty = 3;
                    difficulty_changed = true;
                }
            }
        }
    }
    if difficulty_changed {
        cell_count = rows * columns;
        let board_width = columns * 32 + 16;
        let board_height = rows * 32 + 16;
        Visuals::SetClientSize(form, board_width + 38, board_height + 176);
        Panel::SetPanelWidth(status_panel, board_width);
        Panel::SetPanelWidth(board_panel, board_width);
        Panel::SetPanelHeight(board_panel, board_height);
        Button::SetButtonLeft(face, (board_width - 60) / 2);
        Label::SetLabelLeft(time_counter, board_width - 100);
        set_board_nodes(board_surface, rows, columns);
        ToolStripMenuItem::SetToolStripMenuItemChecked(beginner_item, difficulty == 0);
        ToolStripMenuItem::SetToolStripMenuItemChecked(intermediate_item, difficulty == 1);
        ToolStripMenuItem::SetToolStripMenuItemChecked(expert_item, difficulty == 2);
        ToolStripMenuItem::SetToolStripMenuItemChecked(custom_item, difficulty == 3);
        action = "new";
    }

    if action == "pause" && active && started {
        if paused {
            paused = false;
            paused_total = paused_total + MonotonicClock::GetMilliseconds() - pause_started_at;
        } else {
            let pause_now = MonotonicClock::GetMilliseconds();
            elapsed = (pause_now - started_at - paused_total) / 1000;
            Visuals::SetSpriteText(time_counter, format_counter(elapsed));
            paused = true;
            pause_started_at = pause_now;
            pressed_index = -1;
        }
        ToolStripMenuItem::SetToolStripMenuItemChecked(pause_item, paused);
        board_changed = true;
    }

    if action == "marks" {
        marks_enabled = !marks_enabled;
        ToolStripMenuItem::SetToolStripMenuItemChecked(marks_item, marks_enabled);
        if !marks_enabled {
            let mut mark_index = 0;
            while mark_index < cell_count {
                if flagged[mark_index].copy() == 2 {
                    flagged[mark_index] = 0;
                    display[mark_index] = 0;
                    board_changed = true;
                }
                mark_index = mark_index + 1;
            }
        }
    }

    if action == "color" {
        color_enabled = !color_enabled;
        ToolStripMenuItem::SetToolStripMenuItemChecked(color_item, color_enabled);
        if color_enabled {
            Scene::ConfigureStyles(board_surface, cell_border_styles, cell_backgrounds, cell_border_colors, cell_foregrounds, cell_texts, cell_sprites);
        } else {
            Scene::ConfigureStyles(board_surface, cell_border_styles, cell_backgrounds, cell_border_colors, monochrome_foregrounds, cell_texts, cell_sprites);
        }
        board_changed = true;
    }

    if action == "best_times" {
        let beginner_time = format_best_time(best_beginner);
        let intermediate_time = format_best_time(best_intermediate);
        let expert_time = format_best_time(best_expert);
        Visuals::ShowMessage(form, "Beginner: " + beginner_time + " seconds\nIntermediate: " + intermediate_time + " seconds\nExpert: " + expert_time + " seconds", "Best Times");
    }
    if action == "contents" {
        Visuals::ShowMessage(form, "Open every square that does not contain a mine.\nRight-click to place a flag or question mark.\nDouble-click a revealed number to open its remaining neighbors.", "Minesweeper Help");
    }
    if action == "about" {
        Visuals::ShowMessage(form, "Minesweeper\nRustScript game logic running on the CLR VM.", "About Minesweeper");
    }

    if action == "new" {
        mines_ready = false;
        active = true;
        started = false;
        paused = false;
        started_at = 0;
        pause_started_at = 0;
        paused_total = 0;
        elapsed = 0;
        flag_count = 0;
        safe_remaining = cell_count - mine_total;
        mines = new_board_array(cell_count);
        revealed = new_board_array(cell_count);
        flagged = new_board_array(cell_count);
        display = new_board_array(cell_count);
        flash_cells = new_board_array(cell_count);
        flash_until = 0;
        pressed_index = -1;
        Visuals::SetSpriteText(mine_counter, format_counter(mine_total));
        Visuals::SetSpriteText(time_counter, "000");
        Visuals::SetControlBitmap(face, smile_bitmap);
        ToolStripMenuItem::SetToolStripMenuItemChecked(pause_item, false);
        board_changed = true;
    }

    let mut open_index = -1;
    let mut flag_index = -1;
    let mut chord_index = -1;
    if pointer_kind == "down" && pointer_button == "Left" && active && !paused {
        pressed_index = board_index_at(pointer_x, pointer_y, rows, columns);
        board_changed = true;
    }
    if pointer_kind == "leave" && pressed_index >= 0 {
        pressed_index = -1;
        board_changed = true;
    }
    if pointer_kind == "up" {
        let pointer_index = board_index_at(pointer_x, pointer_y, rows, columns);
        if pointer_button == "Left" && pointer_index == pressed_index {
            open_index = pointer_index;
        }
        if pointer_button == "Right" {
            flag_index = pointer_index;
        }
        if pressed_index >= 0 {
            pressed_index = -1;
            board_changed = true;
        }
    }
    if pointer_kind == "double" && pointer_button == "Left" {
        chord_index = board_index_at(pointer_x, pointer_y, rows, columns);
    }

    if flag_index >= 0 && active && !paused && revealed[flag_index].copy() == 0 {
        if flagged[flag_index].copy() == 0 {
            flagged[flag_index] = 1;
            flag_count = flag_count + 1;
            display[flag_index] = 1;
        } else {
            if flagged[flag_index].copy() == 1 {
                flag_count = flag_count - 1;
                if marks_enabled {
                    flagged[flag_index] = 2;
                    display[flag_index] = 14;
                } else {
                    flagged[flag_index] = 0;
                    display[flag_index] = 0;
                }
            } else {
                flagged[flag_index] = 0;
                display[flag_index] = 0;
            }
        }
        Visuals::SetSpriteText(mine_counter, format_counter(mine_total - flag_count));
        board_changed = true;
    }

    if open_index >= 0 && active && !paused && flagged[open_index].copy() != 1 && revealed[open_index].copy() == 0 {
        if !mines_ready {
            let mut placed = 0;
            while placed < mine_total {
                let position = Random::NextInt32Instance(random, cell_count);
                if position != open_index && mines[position].copy() == 0 {
                    mines[position] = 1;
                    placed = placed + 1;
                }
            }
            mines_ready = true;
            started = true;
            started_at = MonotonicClock::GetMilliseconds();
        }

        if mines[open_index].copy() == 1 {
            active = false;
            started = false;
            Visuals::SetControlBitmap(face, dead_bitmap);
            board_changed = true;
            let mut loss_index = 0;
            while loss_index < cell_count {
                if mines[loss_index].copy() == 1 {
                    if loss_index == open_index {
                        display[loss_index] = 12;
                    } else {
                        display[loss_index] = 11;
                    }
                }
                if mines[loss_index].copy() == 0 && flagged[loss_index].copy() == 1 {
                    display[loss_index] = 13;
                }
                loss_index = loss_index + 1;
            }
        } else {
            let mut queue = new_board_array(cell_count);
            let mut queued = new_board_array(cell_count);
            queue[0] = open_index;
            queued[open_index] = 1;
            let mut queue_index = 0;
            let mut queue_length = 1;
            while queue_index < queue_length {
                let current = queue[queue_index].copy();
                if revealed[current].copy() == 0 && flagged[current].copy() != 1 && mines[current].copy() == 0 {
                    revealed[current] = 1;
                    safe_remaining = safe_remaining - 1;
                    let current_row = current / columns;
                    let current_column = current % columns;
                    let mut count = 0;
                    let mut count_row_delta = -1;
                    while count_row_delta <= 1 {
                        let mut count_column_delta = -1;
                        while count_column_delta <= 1 {
                            let count_row = current_row + count_row_delta;
                            let count_column = current_column + count_column_delta;
                            if (count_row_delta != 0 || count_column_delta != 0) &&
                               count_row >= 0 && count_row < rows &&
                               count_column >= 0 && count_column < columns {
                                count = count + mines[count_row * columns + count_column].copy();
                            }
                            count_column_delta = count_column_delta + 1;
                        }
                        count_row_delta = count_row_delta + 1;
                    }

                    display[current] = 2 + count;
                    board_changed = true;
                    if count == 0 {
                        let mut reveal_row_delta = -1;
                        while reveal_row_delta <= 1 {
                            let mut reveal_column_delta = -1;
                            while reveal_column_delta <= 1 {
                                let reveal_row = current_row + reveal_row_delta;
                                let reveal_column = current_column + reveal_column_delta;
                                if reveal_row >= 0 && reveal_row < rows &&
                                   reveal_column >= 0 && reveal_column < columns {
                                    let neighbor = reveal_row * columns + reveal_column;
                                    if revealed[neighbor].copy() == 0 &&
                                       flagged[neighbor].copy() != 1 &&
                                       queued[neighbor].copy() == 0 {
                                        queue[queue_length] = neighbor;
                                        queued[neighbor] = 1;
                                        queue_length = queue_length + 1;
                                    }
                                }
                                reveal_column_delta = reveal_column_delta + 1;
                            }
                            reveal_row_delta = reveal_row_delta + 1;
                        }
                    }
                }
                queue_index = queue_index + 1;
            }

            if safe_remaining == 0 {
                elapsed = (MonotonicClock::GetMilliseconds() - started_at - paused_total) / 1000;
                active = false;
                started = false;
                flag_count = mine_total;
                Visuals::SetSpriteText(mine_counter, "000");
                Visuals::SetSpriteText(time_counter, format_counter(elapsed));
                Visuals::SetControlBitmap(face, win_bitmap);
                if difficulty == 0 && (best_beginner < 0 || elapsed < best_beginner) {
                    best_beginner = elapsed;
                }
                if difficulty == 1 && (best_intermediate < 0 || elapsed < best_intermediate) {
                    best_intermediate = elapsed;
                }
                if difficulty == 2 && (best_expert < 0 || elapsed < best_expert) {
                    best_expert = elapsed;
                }
                let mut win_index = 0;
                while win_index < cell_count {
                    if mines[win_index].copy() == 1 {
                        flagged[win_index] = 1;
                        display[win_index] = 1;
                    }
                    win_index = win_index + 1;
                }
                board_changed = true;
            }
        }
    }

    // Classic chord action: double-click a revealed number to open every
    // unflagged neighbor when the adjacent flag count matches the number.
    if chord_index >= 0 && active && !paused && revealed[chord_index].copy() == 1 {
        let chord_number = display[chord_index].copy() - 2;
        if chord_number >= 0 && chord_number <= 8 {
            let chord_row = chord_index / columns;
            let chord_column = chord_index % columns;
            let mut adjacent_flags = 0;
            flash_cells = new_board_array(cell_count);
            let mut flash_count = 0;
            let mut chord_row_delta = -1;
            while chord_row_delta <= 1 {
                let mut chord_column_delta = -1;
                while chord_column_delta <= 1 {
                    let neighbor_row = chord_row + chord_row_delta;
                    let neighbor_column = chord_column + chord_column_delta;
                    if (chord_row_delta != 0 || chord_column_delta != 0) &&
                       neighbor_row >= 0 && neighbor_row < rows &&
                       neighbor_column >= 0 && neighbor_column < columns {
                        let neighbor = neighbor_row * columns + neighbor_column;
                        if flagged[neighbor].copy() == 1 {
                            adjacent_flags = adjacent_flags + 1;
                        }
                        if revealed[neighbor].copy() == 0 && flagged[neighbor].copy() != 1 {
                            flash_cells[neighbor] = 1;
                            flash_count = flash_count + 1;
                        }
                    }
                    chord_column_delta = chord_column_delta + 1;
                }
                chord_row_delta = chord_row_delta + 1;
            }

            if flash_count > 0 && adjacent_flags != chord_number {
                flash_until = MonotonicClock::GetMilliseconds() + 140;
                board_changed = true;
            }

            if flash_count > 0 && adjacent_flags == chord_number {
                let mut queue = new_board_array(cell_count);
                let mut queued = new_board_array(cell_count);
                let mut queue_length = 0;
                let mut chord_mine = -1;
                let mut seed_row_delta = -1;
                while seed_row_delta <= 1 {
                    let mut seed_column_delta = -1;
                    while seed_column_delta <= 1 {
                        let seed_row = chord_row + seed_row_delta;
                        let seed_column = chord_column + seed_column_delta;
                        if (seed_row_delta != 0 || seed_column_delta != 0) &&
                           seed_row >= 0 && seed_row < rows &&
                           seed_column >= 0 && seed_column < columns {
                            let seed = seed_row * columns + seed_column;
                            if revealed[seed].copy() == 0 && flagged[seed].copy() != 1 {
                                if mines[seed].copy() == 1 {
                                    if chord_mine < 0 {
                                        chord_mine = seed;
                                    }
                                } else {
                                    queue[queue_length] = seed;
                                    queued[seed] = 1;
                                    queue_length = queue_length + 1;
                                }
                            }
                        }
                        seed_column_delta = seed_column_delta + 1;
                    }
                    seed_row_delta = seed_row_delta + 1;
                }

                if chord_mine >= 0 {
                    active = false;
                    started = false;
                    Visuals::SetControlBitmap(face, dead_bitmap);
                    board_changed = true;
                    let mut loss_index = 0;
                    while loss_index < cell_count {
                        if mines[loss_index].copy() == 1 {
                            if loss_index == chord_mine {
                                display[loss_index] = 12;
                            } else {
                                display[loss_index] = 11;
                            }
                        }
                        if mines[loss_index].copy() == 0 && flagged[loss_index].copy() == 1 {
                            display[loss_index] = 13;
                        }
                        loss_index = loss_index + 1;
                    }
                } else {
                    let mut queue_index = 0;
                    while queue_index < queue_length {
                        let current = queue[queue_index].copy();
                        if revealed[current].copy() == 0 &&
                           flagged[current].copy() != 1 &&
                           mines[current].copy() == 0 {
                            revealed[current] = 1;
                            safe_remaining = safe_remaining - 1;
                            let current_row = current / columns;
                            let current_column = current % columns;
                            let mut count = 0;
                            let mut count_row_delta = -1;
                            while count_row_delta <= 1 {
                                let mut count_column_delta = -1;
                                while count_column_delta <= 1 {
                                    let count_row = current_row + count_row_delta;
                                    let count_column = current_column + count_column_delta;
                                    if (count_row_delta != 0 || count_column_delta != 0) &&
                                       count_row >= 0 && count_row < rows &&
                                       count_column >= 0 && count_column < columns {
                                        count = count + mines[count_row * columns + count_column].copy();
                                    }
                                    count_column_delta = count_column_delta + 1;
                                }
                                count_row_delta = count_row_delta + 1;
                            }

                            display[current] = 2 + count;
                            board_changed = true;
                            if count == 0 {
                                let mut reveal_row_delta = -1;
                                while reveal_row_delta <= 1 {
                                    let mut reveal_column_delta = -1;
                                    while reveal_column_delta <= 1 {
                                        let reveal_row = current_row + reveal_row_delta;
                                        let reveal_column = current_column + reveal_column_delta;
                                        if reveal_row >= 0 && reveal_row < rows &&
                                           reveal_column >= 0 && reveal_column < columns {
                                            let neighbor = reveal_row * columns + reveal_column;
                                            if revealed[neighbor].copy() == 0 &&
                                               flagged[neighbor].copy() != 1 &&
                                               queued[neighbor].copy() == 0 {
                                                queue[queue_length] = neighbor;
                                                queued[neighbor] = 1;
                                                queue_length = queue_length + 1;
                                            }
                                        }
                                        reveal_column_delta = reveal_column_delta + 1;
                                    }
                                    reveal_row_delta = reveal_row_delta + 1;
                                }
                            }
                        }
                        queue_index = queue_index + 1;
                    }

                    if safe_remaining == 0 {
                        elapsed = (MonotonicClock::GetMilliseconds() - started_at - paused_total) / 1000;
                        active = false;
                        started = false;
                        flag_count = mine_total;
                        Visuals::SetSpriteText(mine_counter, "000");
                        Visuals::SetSpriteText(time_counter, format_counter(elapsed));
                        Visuals::SetControlBitmap(face, win_bitmap);
                        if difficulty == 0 && (best_beginner < 0 || elapsed < best_beginner) {
                            best_beginner = elapsed;
                        }
                        if difficulty == 1 && (best_intermediate < 0 || elapsed < best_intermediate) {
                            best_intermediate = elapsed;
                        }
                        if difficulty == 2 && (best_expert < 0 || elapsed < best_expert) {
                            best_expert = elapsed;
                        }
                        let mut win_index = 0;
                        while win_index < cell_count {
                            if mines[win_index].copy() == 1 {
                                flagged[win_index] = 1;
                                display[win_index] = 1;
                            }
                            win_index = win_index + 1;
                        }
                        board_changed = true;
                    }
                }
            }
        }
    }

    if board_changed {
        let mut render_styles = new_board_array(cell_count);
        let mut render_index = 0;
        while render_index < cell_count {
            let mut render_style = display[render_index].copy();
            if paused {
                render_style = 0;
            }
            if flash_until > 0 && flash_cells[render_index].copy() == 1 {
                render_style = 2;
            }
            if render_index == pressed_index && render_style == 0 {
                render_style = 2;
            }
            render_styles[render_index] = render_style;
            render_index = render_index + 1;
        }
        render_styles = Scene::Present(board_surface, render_styles);
    }

    if action == "close" {
        Ui::Close(form);
        break;
    }
}

Random::ReleaseRandom(random);
