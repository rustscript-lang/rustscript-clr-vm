fn render_board(render_rows: int, render_columns: int, render_paused: bool, render_flash_until: int, render_pressed_index: int) -> null {
    // These arrays are resized when the difficulty changes. Borrow the root
    // slots so this renderer observes the replacement arrays instead of the
    // 8x8 values captured during startup.
    let current_display = &display;
    let current_flash_cells = &flash_cells;
    let mut render_styles = new_board_array(render_rows * render_columns);
    let mut render_index = 0;
    while render_index < render_rows * render_columns {
        let mut render_style = current_display[render_index].copy();
        if render_paused {
            render_style = 0;
        }
        if render_flash_until > 0 && current_flash_cells[render_index].copy() == 1 {
            render_style = 2;
        }
        if render_index == render_pressed_index && render_style == 0 {
            render_style = 2;
        }
        render_styles[render_index] = render_style;
        render_index = render_index + 1;
    }
    render_styles = Scene::Present(board_surface, render_styles);
    null
}

fn reset_game() -> null {
    let mut game = &mut state;
    game.active = true;
    game.started = false;
    game.paused = false;
    game.started_at = 0;
    game.pause_started_at = 0;
    game.paused_total = 0;
    game.elapsed = 0;
    game.flag_count = 0;
    game.safe_remaining = game.rows.copy() * game.columns.copy() - game.mine_total.copy();
    mines = new_board_array(game.rows.copy() * game.columns.copy());
    revealed = new_board_array(game.rows.copy() * game.columns.copy());
    flagged = new_board_array(game.rows.copy() * game.columns.copy());
    display = new_board_array(game.rows.copy() * game.columns.copy());
    flash_cells = new_board_array(game.rows.copy() * game.columns.copy());
    game.flash_until = 0;
    game.pressed_index = -1;
    Visuals::SetSpriteText(mine_counter, format_counter(game.mine_total.copy()));
    Visuals::SetSpriteText(time_counter, "000");
    Visuals::SetControlBitmap(face, smile_bitmap);
