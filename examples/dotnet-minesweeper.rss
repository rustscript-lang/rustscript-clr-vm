fn format_counter(value: int) -> string {
    let mut current = value;
    if current > 999 {
        current = 999;
    }
    if current < -99 {
        current = -99;
    }

    let mut text = "";
    if current < 0 {
        let magnitude = 0 - current;
        if magnitude < 10 {
            text = "-0" + magnitude;
        } else {
            text = "-" + magnitude;
        }
    } else {
        if current < 10 {
            text = "00" + current;
        }
        if current >= 10 && current < 100 {
            text = "0" + current;
        }
        if current >= 100 {
            text = "" + current;
        }
    }
    text
}

fn format_best_time(value: int) -> string {
    let mut text = "--";
    if value >= 0 {
        text = format_counter(value);
    }
    text
}

fn new_board_array(size: int) -> [int] {
    let mut values: [int] = [];
    let mut index = 0;
    while index < size {
        values[values.length] = 0;
        index = index + 1;
    }
    values
}

fn parse_positive_int(text: string) -> int {
    let mut value = 0;
    let mut valid = text.length > 0;
    let mut index = 0;
    while index < text.length {
        let character = text[index:index + 1];
        let mut digit = -1;
        if character == "0" { digit = 0; }
        if character == "1" { digit = 1; }
        if character == "2" { digit = 2; }
        if character == "3" { digit = 3; }
        if character == "4" { digit = 4; }
        if character == "5" { digit = 5; }
        if character == "6" { digit = 6; }
        if character == "7" { digit = 7; }
        if character == "8" { digit = 8; }
        if character == "9" { digit = 9; }
        if digit < 0 || value > 1000000 {
            valid = false;
        } else {
            value = value * 10 + digit;
        }
        index = index + 1;
    }
    let mut result = -1;
    if valid {
        result = value;
    }
    result
}

