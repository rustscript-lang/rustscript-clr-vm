fn set_board_nodes(surface: int, rows: int, columns: int) {
    let count = rows * columns;
    let mut lefts = new_board_array(count);
    let mut tops = new_board_array(count);
    let mut widths = new_board_array(count);
    let mut heights = new_board_array(count);
    let mut index = 0;
    while index < count {
        lefts[index] = 2 + (index % columns) * 32;
        tops[index] = 2 + (index / columns) * 32;
        widths[index] = 32;
        heights[index] = 32;
        index = index + 1;
    }
    Scene::SetNodes(surface, lefts, tops, widths, heights);
}

fn board_index_at(x: int, y: int, rows: int, columns: int) -> int {
    let mut result = -1;
    let local_x = x - 2;
    let local_y = y - 2;
    if local_x >= 0 && local_y >= 0 {
        let column = local_x / 32;
        let row = local_y / 32;
        if row >= 0 && row < rows && column >= 0 && column < columns {
            result = row * columns + column;
        }
    }
    result
}

