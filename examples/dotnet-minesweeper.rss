fn on_board_down(event: map<string>) -> null {
    let mut game = &mut state;
    if event.button.copy() == "Left" && game.active.copy() && !game.paused.copy() => {
        game.pressed_index = board_index_at(parse_positive_int(event.x.copy()), parse_positive_int(event.y.copy()), game.rows.copy(), game.columns.copy());
        let _board_rendered = render_board(game.rows.copy(), game.columns.copy(), game.paused.copy(), game.flash_until.copy(), game.pressed_index.copy());
        null
    } else => { null };
    null
}
fn on_board_up(event: map<string>) -> null {
    let mut game = &mut state;
    let current_revealed = &revealed;
    let pointer_index = board_index_at(parse_positive_int(event.x.copy()), parse_positive_int(event.y.copy()), game.rows.copy(), game.columns.copy());
    let pointer_button: string = event.button.copy();
    if pointer_button == "Left" && pointer_index == game.pressed_index.copy() {
        let _cell_opened = open_cell(pointer_index);
    }
    if pointer_button == "Right" {
        if pointer_index >= 0 && game.active.copy() && !game.paused.copy() && current_revealed[pointer_index].copy() == 0 {
            if flagged[pointer_index].copy() == 0 {
                flagged[pointer_index] = 1;
                game.flag_count = game.flag_count.copy() + 1;
                display[pointer_index] = 1;
            } else {
                if flagged[pointer_index].copy() == 1 {
                    game.flag_count = game.flag_count.copy() - 1;
                    if game.marks_enabled.copy() {
                        flagged[pointer_index] = 2;
                        display[pointer_index] = 14;
                    } else {
                        flagged[pointer_index] = 0;
                        display[pointer_index] = 0;
                    }
                } else {
                    flagged[pointer_index] = 0;
                    display[pointer_index] = 0;
                }
            }
            Visuals::SetSpriteText(mine_counter, format_counter(game.mine_total.copy() - game.flag_count.copy()));
        }
    }
    if game.pressed_index.copy() >= 0 {
        game.pressed_index = -1;
    }
    let _board_rendered = render_board(game.rows.copy(), game.columns.copy(), game.paused.copy(), game.flash_until.copy(), game.pressed_index.copy());
    null
}
fn on_board_double_click(event: map<string>) -> null {
    let mut game = &mut state;
    let current_revealed = &revealed;
    let current_flagged = &flagged;
    let current_display = &display;
    if event.button.copy() == "Left" {
        let chord_index = board_index_at(parse_positive_int(event.x.copy()), parse_positive_int(event.y.copy()), game.rows.copy(), game.columns.copy());
        if chord_index >= 0 && game.active.copy() && !game.paused.copy() && current_revealed[chord_index].copy() == 1 {
            let chord_number = current_display[chord_index].copy() - 2;
            if chord_number >= 0 && chord_number <= 8 {
                let chord_row = chord_index / game.columns.copy();
                let chord_column = chord_index % game.columns.copy();
                let mut adjacent_flags = 0;
                flash_cells = new_board_array(game.rows.copy() * game.columns.copy());
                let mut flash_count = 0;
                let mut row_delta = -1;
                while row_delta <= 1 {
                    let mut column_delta = -1;
                    while column_delta <= 1 {
                        let neighbor_row = chord_row + row_delta;
                        let neighbor_column = chord_column + column_delta;
                        if (row_delta != 0 || column_delta != 0) &&
                           neighbor_row >= 0 && neighbor_row < game.rows.copy() &&
                           neighbor_column >= 0 && neighbor_column < game.columns.copy() {
                            let neighbor = neighbor_row * game.columns.copy() + neighbor_column;
                            if current_flagged[neighbor].copy() == 1 {
                                adjacent_flags = adjacent_flags + 1;
                            }
                            if current_revealed[neighbor].copy() == 0 && current_flagged[neighbor].copy() != 1 {
                                flash_cells[neighbor] = 1;
                                flash_count = flash_count + 1;
                            }
                        }
                        column_delta = column_delta + 1;
                    }
                    row_delta = row_delta + 1;
                }

                if flash_count > 0 && adjacent_flags != chord_number {
                    game.flash_until = MonotonicClock::GetMilliseconds() + 140;
                }

                if flash_count > 0 && adjacent_flags == chord_number {
                    let mut open_row_delta = -1;
                    while open_row_delta <= 1 && game.active.copy() {
                        let mut open_column_delta = -1;
                        while open_column_delta <= 1 && game.active.copy() {
                            let open_row = chord_row + open_row_delta;
                            let open_column = chord_column + open_column_delta;
                            if (open_row_delta != 0 || open_column_delta != 0) &&
                               open_row >= 0 && open_row < game.rows.copy() &&
                               open_column >= 0 && open_column < game.columns.copy() {
                                let _cell_opened = open_cell(open_row * game.columns.copy() + open_column);
                            }
                            open_column_delta = open_column_delta + 1;
                        }
                        open_row_delta = open_row_delta + 1;
                    }
                }
            }
        }
        let _board_rendered = render_board(game.rows.copy(), game.columns.copy(), game.paused.copy(), game.flash_until.copy(), game.pressed_index.copy());
    }
    null
}
fn on_board_leave(event: map<string>) -> null {
    let mut game = &mut state;
    if game.pressed_index.copy() >= 0 {
        game.pressed_index = -1;
        let _board_rendered = render_board(game.rows.copy(), game.columns.copy(), game.paused.copy(), game.flash_until.copy(), game.pressed_index.copy());
    }
    null
}
