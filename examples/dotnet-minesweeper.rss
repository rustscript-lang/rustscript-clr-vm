fn on_timer_tick() -> null {
    let mut game = &mut state;
    let mut board_changed = false;
    if game.flash_until.copy() > 0 && MonotonicClock::GetMilliseconds() >= game.flash_until.copy() {
        game.flash_until = 0;
        flash_cells = new_board_array(game.rows.copy() * game.columns.copy());
        board_changed = true;
    }
    if game.active.copy() && game.started.copy() && !game.paused.copy() {
        let measured_elapsed = (MonotonicClock::GetMilliseconds() - game.started_at.copy() - game.paused_total.copy()) / 1000;
        if measured_elapsed != game.elapsed.copy() {
            game.elapsed = measured_elapsed;
            Visuals::SetSpriteText(time_counter, format_counter(game.elapsed.copy()));
        }
    }
    if board_changed {
        let _board_rendered = render_board(game.rows.copy(), game.columns.copy(), game.paused.copy(), game.flash_until.copy(), game.pressed_index.copy());
    }
    null
}

