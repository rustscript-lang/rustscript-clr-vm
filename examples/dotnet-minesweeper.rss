fn open_cell(open_index: int) -> null {
    let mut game = &mut state;
    if open_index >= 0 && game.active.copy() && !game.paused.copy() && flagged[open_index].copy() != 1 && revealed[open_index].copy() == 0 {
        if !game.started.copy() {
            let mut placed = 0;
            while placed < game.mine_total.copy() {
                let position = Random::NextInt32Instance(random, game.rows.copy() * game.columns.copy());
                if position != open_index && mines[position].copy() == 0 {
                    mines[position] = 1;
                    placed = placed + 1;
                }
            }
            game.started = true;
            game.started_at = MonotonicClock::GetMilliseconds();
        }

        if mines[open_index].copy() == 1 {
            game.active = false;
            game.started = false;
            Visuals::SetControlBitmap(face, dead_bitmap);
            let mut loss_index = 0;
            while loss_index < game.rows.copy() * game.columns.copy() {
                if mines[loss_index].copy() == 1 {
                    if loss_index == open_index {
                        display[loss_index] = 12;
                    } else {
                        display[loss_index] = 11;
                    }
                }
                if mines[loss_index].copy() == 0 && flagged[loss_index].copy() == 1 {
                    display[loss_index] = 13;
                }
                loss_index = loss_index + 1;
            }
        } else {
            let mut queue = new_board_array(game.rows.copy() * game.columns.copy());
            let mut queued = new_board_array(game.rows.copy() * game.columns.copy());
            queue[0] = open_index;
            queued[open_index] = 1;
            let mut queue_index = 0;
            let mut queue_length = 1;
            while queue_index < queue_length {
                let current = queue[queue_index].copy();
                if revealed[current].copy() == 0 && flagged[current].copy() != 1 && mines[current].copy() == 0 {
                    revealed[current] = 1;
                    game.safe_remaining = game.safe_remaining.copy() - 1;
                    let current_row = current / game.columns.copy();
                    let current_column = current % game.columns.copy();
                    let mut count = 0;
                    let mut count_row_delta = -1;
                    while count_row_delta <= 1 {
                        let mut count_column_delta = -1;
                        while count_column_delta <= 1 {
                            let count_row = current_row + count_row_delta;
                            let count_column = current_column + count_column_delta;
                            if (count_row_delta != 0 || count_column_delta != 0) &&
                               count_row >= 0 && count_row < game.rows.copy() &&
                               count_column >= 0 && count_column < game.columns.copy() {
                                count = count + mines[count_row * game.columns.copy() + count_column].copy();
                            }
                            count_column_delta = count_column_delta + 1;
                        }
                        count_row_delta = count_row_delta + 1;
                    }

                    display[current] = 2 + count;
                    if count == 0 {
                        let mut reveal_row_delta = -1;
                        while reveal_row_delta <= 1 {
                            let mut reveal_column_delta = -1;
                            while reveal_column_delta <= 1 {
                                let reveal_row = current_row + reveal_row_delta;
                                let reveal_column = current_column + reveal_column_delta;
                                if reveal_row >= 0 && reveal_row < game.rows.copy() &&
                                   reveal_column >= 0 && reveal_column < game.columns.copy() {
                                    let neighbor = reveal_row * game.columns.copy() + reveal_column;
                                    if revealed[neighbor].copy() == 0 &&
                                       flagged[neighbor].copy() != 1 &&
                                       queued[neighbor].copy() == 0 {
                                        queue[queue_length] = neighbor;
                                        queued[neighbor] = 1;
                                        queue_length = queue_length + 1;
                                    }
                                }
                                reveal_column_delta = reveal_column_delta + 1;
                            }
                            reveal_row_delta = reveal_row_delta + 1;
                        }
                    }
                }
                queue_index = queue_index + 1;
            }
            if game.safe_remaining.copy() == 0 {
                game.elapsed = (MonotonicClock::GetMilliseconds() - game.started_at.copy() - game.paused_total.copy()) / 1000;
                game.active = false;
                game.started = false;
                game.flag_count = game.mine_total.copy();
                Visuals::SetSpriteText(mine_counter, "000");
                Visuals::SetSpriteText(time_counter, format_counter(game.elapsed.copy()));
                Visuals::SetControlBitmap(face, win_bitmap);
                if game.difficulty.copy() == 0 && (game.beginner_best_time.copy() < 0 || game.elapsed.copy() < game.beginner_best_time.copy()) {
                    game.beginner_best_time = game.elapsed.copy();
                }
                if game.difficulty.copy() == 1 && (game.intermediate_best_time.copy() < 0 || game.elapsed.copy() < game.intermediate_best_time.copy()) {
                    game.intermediate_best_time = game.elapsed.copy();
                }
                if game.difficulty.copy() == 2 && (game.expert_best_time.copy() < 0 || game.elapsed.copy() < game.expert_best_time.copy()) {
                    game.expert_best_time = game.elapsed.copy();
                }
                let mut win_index = 0;
                while win_index < game.rows.copy() * game.columns.copy() {
                    if mines[win_index].copy() == 1 {
                        flagged[win_index] = 1;
                        display[win_index] = 1;
                    }
                    win_index = win_index + 1;
                }
            }
        }
    }
    null
}

fn on_pause() -> null {
    let mut game = &mut state;
    if game.active.copy() && game.started.copy() => {
        if game.paused.copy() {
            game.paused = false;
            game.paused_total = game.paused_total.copy() + MonotonicClock::GetMilliseconds() - game.pause_started_at.copy();
        } else {
            let pause_now = MonotonicClock::GetMilliseconds();
            game.elapsed = (pause_now - game.started_at.copy() - game.paused_total.copy()) / 1000;
            Visuals::SetSpriteText(time_counter, format_counter(game.elapsed.copy()));
            game.paused = true;
            game.pause_started_at = pause_now;
            game.pressed_index = -1;
        }
        ToolStripMenuItem::SetToolStripMenuItemChecked(pause_item, game.paused.copy());
        let _board_rendered = render_board(game.rows.copy(), game.columns.copy(), game.paused.copy(), game.flash_until.copy(), game.pressed_index.copy());
        null
    } else => { null };
    null
}
fn on_beginner() -> null {
    let _difficulty_selected = select_difficulty(8, 8, 10, 0);
    null
}

fn on_intermediate() -> null {
    let _difficulty_selected = select_difficulty(16, 16, 40, 1);
    null
}

fn on_expert() -> null {
    let _difficulty_selected = select_difficulty(16, 30, 99, 2);
    null
}

fn on_custom() -> null {
    let mut game = &mut state;
    let custom_values = show_custom_fields(form, game.rows.copy(), game.columns.copy(), game.mine_total.copy());
    if custom_values[0].copy() == "ok" {
        let requested_rows = parse_positive_int(custom_values[1].copy());
        let requested_columns = parse_positive_int(custom_values[2].copy());
        let requested_mines = parse_positive_int(custom_values[3].copy());
        if requested_rows < 8 || requested_rows > 24 || requested_columns < 8 || requested_columns > 30 {
            Visuals::ShowMessage(form, "Height must be from 8 to 24, and width must be from 8 to 30.", "Custom Field");
        } else {
            if requested_mines < 1 || requested_mines >= requested_rows * requested_columns {
                Visuals::ShowMessage(form, "Mines must be at least 1 and less than the number of squares.", "Custom Field");
            } else {
                let _difficulty_selected = select_difficulty(requested_rows, requested_columns, requested_mines, 3);
            }
        }
    }
    null
}
fn on_marks() -> null {
    let mut game = &mut state;
    game.marks_enabled = !game.marks_enabled.copy();
    ToolStripMenuItem::SetToolStripMenuItemChecked(marks_item, game.marks_enabled.copy());
    let mut board_changed = false;
    if !game.marks_enabled.copy() {
        let mut mark_index = 0;
        while mark_index < game.rows.copy() * game.columns.copy() {
            if flagged[mark_index].copy() == 2 {
                flagged[mark_index] = 0;
                display[mark_index] = 0;
                board_changed = true;
            }
            mark_index = mark_index + 1;
        }
    }
    if board_changed {
        let _board_rendered = render_board(game.rows.copy(), game.columns.copy(), game.paused.copy(), game.flash_until.copy(), game.pressed_index.copy());
    }
    null
}
fn on_color() -> null {
    let mut game = &mut state;
    game.color_enabled = !game.color_enabled.copy();
    ToolStripMenuItem::SetToolStripMenuItemChecked(color_item, game.color_enabled.copy());
    if game.color_enabled.copy() {
        Scene::ConfigureStyles(board_surface, cell_border_styles, cell_backgrounds, cell_border_colors, cell_foregrounds, cell_texts, cell_sprites);
    } else {
        Scene::ConfigureStyles(board_surface, cell_border_styles, cell_backgrounds, cell_border_colors, monochrome_foregrounds, cell_texts, cell_sprites);
    }
    let _board_rendered = render_board(game.rows.copy(), game.columns.copy(), game.paused.copy(), game.flash_until.copy(), game.pressed_index.copy());
    null
}
fn on_best_times() -> null {
